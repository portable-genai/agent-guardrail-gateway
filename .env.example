# A1 Agent Guardrail Gateway — environment template. Copy to .env and adjust.
#
# Dev + test default profile is `local`: an SDK-free, offline stack that runs the whole
# screen + redact pipeline with no Google Cloud SDKs, no API key and no emulators.
GUARDRAIL_PROFILE=local        # gcp | local | onprem

# On a backend error: block input / withhold output (fail safe). Default true.
GUARDRAIL_FAIL_CLOSED=true

# --- bank-owned policy numbers (B4). Defaults equal the reference constants. -----------
# Which finding categories block an INPUT prompt, and the weakest confidence that blocks.
# GUARDRAIL_BLOCK_CATEGORIES=prompt_injection,jailbreak,malicious_url
# GUARDRAIL_BLOCK_MIN_CONFIDENCE=low        # low | medium | high

# --- jurisdiction PII packs (C4) -------------------------------------------------------
# National-identifier rows loaded from the shared pii-kit, for BOTH the runtime redactor
# and the offline eval gate. Supported: SG, HK, JP, AU, IN, GB. Set your own market.
# GUARDRAIL_PII_JURISDICTIONS=SG,HK

# --- gcp profile only (Model Armor + DLP, region asia-southeast1) ---------------------
# GUARDRAIL_PROFILE=gcp
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GUARDRAIL_MODEL_ARMOR_TEMPLATE=hrz-guardrail
# GUARDRAIL_DLP_DEIDENTIFY_TEMPLATE=projects/your-gcp-project/locations/asia-southeast1/deidentifyTemplates/hrz-pii-deidentify
# GUARDRAIL_DLP_INSPECT_TEMPLATE=projects/your-gcp-project/locations/asia-southeast1/inspectTemplates/hrz-pii-inspect

# --- optional higher-fidelity local runs (opt-in Google emulators, never required) -----
# This gateway owns no emulatable store (Model Armor + DLP have no emulator), so these are
# inert here and documented for catalog consistency with the sibling platform services.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# PUBSUB_EMULATOR_HOST=localhost:8085
# STORAGE_EMULATOR_HOST=localhost:9000
